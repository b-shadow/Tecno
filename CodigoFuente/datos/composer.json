{
    "name": "grupo05sa/datos",
    "description": "Capa 3 (persistencia) del CRM UNEXO: modelos Eloquent, repositorios, migraciones y datos semilla sobre PostgreSQL.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Datos\\": "src/",
            "Database\\Seeders\\": "semillas/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Datos\\DatosServiceProvider"]
        }
    }
}
