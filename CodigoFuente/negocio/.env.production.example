APP_NAME="CRM Comercial Educativo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.tecnoweb.org.bo/inf513/grupo05sa/proyecto2
ASSET_URL=https://www.tecnoweb.org.bo/inf513/grupo05sa/proyecto2
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# Runtime from PHP on Tecnoweb; external migration clients use db.tecnoweb.org.bo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_grupo05sa
DB_USERNAME=grupo05sa
DB_PASSWORD=change_me

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.edu
MAIL_PORT=587
MAIL_USERNAME=crm@example.edu
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="crm@example.edu"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://www.tecnoweb.org.bo/inf513/grupo05sa/proyecto2

STRIPE_KEY=pk_test_example
STRIPE_SECRET=sk_test_example
STRIPE_CURRENCY=bob
# Webhook: en Stripe (modo prueba) > Desarrolladores > Webhooks > Agregar destino, URL
#   https://www.tecnoweb.org.bo/inf513/grupo05sa/proyecto2/api/stripe/webhook
#   eventos: checkout.session.completed, checkout.session.expired, payment_intent.succeeded, payment_intent.payment_failed
# y pegar aquí SU "secreto de firma". No sirve el whsec_ de `stripe listen` (ese es solo para la PC local).
STRIPE_WEBHOOK_SECRET=whsec_example
